# Database: leave unset to use local SQLite. For production use Postgres (e.g. Neon / Supabase free tier)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Speech engine: "whisper" (real, open-source) or "mock" (for tests / UI demo without a model)
STT_ENGINE=whisper
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
