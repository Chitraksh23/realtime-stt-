# Speech engine: "gemini" (default, Gemini Live API) | "whisper" (self-hosted) | "mock" (tests/UI demo)
STT_ENGINE=gemini
GEMINI_API_KEY=your-key-from-aistudio.google.com/apikey

# Database: leave unset to use local SQLite. For production use Postgres (Neon / Supabase free tier)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
